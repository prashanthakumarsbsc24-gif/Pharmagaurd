# Copy this file to .env and fill in the values.   (.env is git-ignored)

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/pharmaguard
# MongoDB Atlas (replace user, password and cluster):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pharmaguard?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=12h
PORT=3000

# Only needed if the React app is hosted on a different origin than the API.
# Comma-separated list. In dev the Vite proxy makes this unnecessary.
CLIENT_ORIGIN=http://localhost:5173
